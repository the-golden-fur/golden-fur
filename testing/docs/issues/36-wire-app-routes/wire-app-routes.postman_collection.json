{
  "info": {
    "name": "Issue #36 - Wire All App Routes (Server Route-Existence Smoke Test)",
    "description": "Hits every mounted server route from Epics A, A-1, B, and C with no/garbage auth. This is a reachability check only (AC-1), not a business-logic test: every request is expected to come back with a real handler status (200/400/401/403) and never a 404, which would mean the route isn't mounted or is being shadowed by an earlier one.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base_url", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "Health check sanity (app.ts is up)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('server is up (200)', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "authRoutes - POST /auth/staff/login (no body)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{base_url}}/auth/staff/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "staff", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('route is mounted (not 404)', () => pm.response.to.not.have.status(404));"
            ]
          }
        }
      ]
    },
    {
