# --- Supabase Configuration ---
# Found in Supabase Dashboard → Settings → API
# Safe to expose to the browser — RLS policies are your access guard.
# This repo's dev branch targets the "golden-fur-dev" Supabase project;
# main targets "golden-fur". Confirm which project ref your local .env
# points at before running migrations or seeds.
VITE_SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# --- Client API Base URL ---
# Prepended to every API call (see e.g. src/features/auth/staff/api/staffAuth.api.ts).
# For local dev, point this at your local Express API (must match
# server/.env's SERVER_PORT). Required in production - see docs/deployment.md.
VITE_API_BASE_URL=http://localhost:3000
