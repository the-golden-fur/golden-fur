# ===== client/.env =====

# --- Supabase Configuration ---
# Found in Supabase Dashboard → Settings → API
# Safe to expose to the browser — RLS policies are your access guard.
VITE_SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# --- Dev Server API Proxy ---
# Read by vite.config.ts only (Node context, not shipped to the browser
# bundle - not VITE_-prefixed on purpose). Where the local Express API
# listens; must match server/.env's SERVER_PORT. Only needed if you run the
# API on a non-default port.
API_PROXY_TARGET=http://localhost:3000


# ===== client/.env.test =====

# --- Supabase Configuration ---
VITE_SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
