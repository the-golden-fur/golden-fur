{
  "name": "golden-fur",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "the-golden-fur",
  "license": "MIT",
  "scripts": {
    "=== ORCHESTRATION ===": "",
    "dev": "concurrently \"npm --prefix client run dev\" \"npm --prefix server run dev\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "=== SETUP ===": "",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "=== CODE QUALITY ===": "",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,less,html,json,md,mdx,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,scss,less,html,json,md,mdx,yaml,yml}\"",
    "=== SUPABASE ===": "",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push",
    "supabase:pull": "supabase db pull",
    "supabase:status": "supabase migration list",
    "supabase:reset": "supabase db reset",
    "supabase:reset:remote": "supabase db reset --linked",
    "supabase:repair": "supabase migration repair",
    "seed:module-1": "tsx supabase/seeds/module-1-staff-auth/module-1-staff-auth.seed.ts",
    "seed:module-2": "tsx supabase/seeds/module-2-customers-pets/module-2-customers-pets.seed.ts",
    "seed:module-3": "tsx supabase/seeds/module-3-maintenance/module-3-maintenance.seed.ts",
    "seed:module-4": "tsx supabase/seeds/module-4-hotel/module-4-hotel.seed.ts",
    "seed:all": "npm run seed:module-1 && npm run seed:module-2 && npm run seed:module-3 && npm run seed:module-4 && tsx supabase/seeds/module-5-promos-vet-catalog/module-5-promos-vet-catalog.seed.ts",
    "test:seed": "vitest run supabase/seeds"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "concurrently": "^9.2.3",
    "dotenv": "^16.6.1",
    "prettier": "^3.7.4",
    "supabase": "^2.48.3",
    "tsx": "^4.22.4",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-golden-fur/golden-fur.git"
  },
  "bugs": {
    "url": "https://github.com/the-golden-fur/golden-fur/issues"
  },
  "homepage": "https://github.com/the-golden-fur/golden-fur#readme"
}
