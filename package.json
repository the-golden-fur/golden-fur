{
  "name": "golden-fur",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "the-golden-fur",
  "license": "MIT",
  "scripts": {
    "=== ORCHESTRATION ===": "",
    "dev": "concurrently \"npm --prefix client run dev\" \"npm --prefix server run dev\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "free-ports": "node scripts/free-ports.mjs 3000 5173",
    "clean": "npm run clean --prefix client && npm run clean --prefix server",
    "=== SETUP ===": "",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "=== CODE QUALITY ===": "",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,css,scss,less,html,json,md,mdx,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,css,scss,less,html,json,md,mdx,yaml,yml}\"",
    "=== SUPABASE ===": "",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push",
    "supabase:pull": "supabase db pull",
    "supabase:status": "supabase migration list",
    "supabase:reset": "supabase db reset",
    "supabase:reset:remote": "supabase db reset --linked",
    "supabase:repair": "supabase migration repair",
    "seed:all": "tsx supabase/seeds/m01-staff-auth/m01-staff-auth.seed.ts && tsx supabase/seeds/m02-customers-pets/m02-customers-pets.seed.ts && tsx supabase/seeds/m05-hotel/m05-hotel.seed.ts && tsx supabase/seeds/m07-veterinary/m07-veterinary.seed.ts && tsx supabase/seeds/m12-discounts/m12-discounts.seed.ts && tsx supabase/seeds/m13-maintenance/m13-maintenance.seed.ts",
    "test:seed": "vitest run supabase/seeds"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "concurrently": "^9.2.3",
    "dotenv": "^16.6.1",
    "prettier": "^3.7.4",
    "supabase": "^2.48.3",
    "tsx": "^4.22.4",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-golden-fur/golden-fur.git"
  },
  "bugs": {
    "url": "https://github.com/the-golden-fur/golden-fur/issues"
  },
  "homepage": "https://github.com/the-golden-fur/golden-fur#readme"
}
