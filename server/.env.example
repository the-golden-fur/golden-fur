# ===== server/.env =====

# --- Execution Environment ---
# Controls app behavior (logging, error detail)
# Options: development, test, production
NODE_ENV=development

# --- Network Configuration ---
SERVER_PORT=3000

# --- Supabase Configuration ---
# Found in Supabase Dashboard → Settings → API
SUPABASE_URL=https://your_project_id.supabase.co
# Anon key / Publishable key
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- CORS ---
# Authorized frontend origins. Comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Resend (transactional email) ---
# NOTE: planned migration to Brevo - Resend is on its way out. Until then
# these keys drive all transactional email; a send with no RESEND_API_KEY
# throws. On environments where email isn't wired up yet (e.g. the client
# hasn't provisioned an account), leave these unset and expect email-
# triggering flows to error - that is understood, not a regression.
# Found in Resend Dashboard (resend.com) -> API keys.
RESEND_API_KEY=your_resend_api_key
# Must be a verified sender/domain in Resend for production; the
# onboarding@resend.dev sandbox address works for local/dev testing only.
RESEND_FROM_EMAIL=Golden Fur <onboarding@resend.dev>

# --- Staff temp-credential encryption ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts a staff member's temporary password at rest (staff_profiles.
# temp_credential_ciphertext/-_iv) so a resend can re-deliver the same
# password instead of generating a new one.
STAFF_TEMP_CREDENTIAL_KEY=your_base64_encoded_32_byte_key

# --- PayMongo (M08 billing, Sprint 5 Epic A #83) ---
# NOTE: the client has not approved a PayMongo account yet. In deployed
# environments these keys sit unset/placeholder and the online-payment
# paths stay dormant (checkout calls 500) - that is expected until the
# account exists. A future admin setting will let staff toggle online
# payments off explicitly instead of relying on absent keys.
# Found in PayMongo Dashboard -> Developers -> API Keys.
PAYMONGO_SECRET_KEY=your_paymongo_secret_key
# Found in PayMongo Dashboard -> Developers -> Webhooks, once a webhook is
# registered pointing at POST /billing/paymongo/webhook.
PAYMONGO_WEBHOOK_SECRET=your_paymongo_webhook_secret
# PayMongo has no public "current rate" API - set this to PayMongo's
# currently published online-payment processing fee percentage (see their
# pricing page) and keep it updated if that rate changes; billing.service.ts
# never hardcodes this number. Defaults to 2.5 if unset.
PAYMONGO_SERVICE_FEE_PERCENT=2.5
# Where PayMongo redirects the customer's browser after a portal GCash/Maya
# payment (client-side routes that then poll/reflect the transaction's
# payment_status - the webhook, not this redirect, is the actual
# confirmation trigger).
PAYMONGO_REDIRECT_SUCCESS_URL=http://localhost:5173/portal/payment/success
PAYMONGO_REDIRECT_FAILED_URL=http://localhost:5173/portal/payment/failed

# --- Booking capacity (optional) ---
# Daycare session capacity when a branch has no explicit override. Either a
# bare number for all branches, or a JSON object keyed by branch id, e.g.
# {"<branchId>": 20}. Defaults to 15 if unset. See
# booking/services/capacity.service.ts.
DAYCARE_SESSION_CAPACITY=15


# ===== server/.env.test =====

NODE_ENV=test
SERVER_PORT=3001
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
