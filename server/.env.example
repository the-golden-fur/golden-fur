# --- Execution Environment ---
# Controls app behavior (logging, error detail)
# Options: development, test, production
NODE_ENV=development

# --- Network Configuration ---
SERVER_PORT=3000

# --- Supabase Configuration ---
# Found in Supabase Dashboard → Settings → API
# This repo's dev branch targets the "golden-fur-dev" Supabase project;
# main targets "golden-fur". Confirm which project ref your local .env
# points at before running migrations or seeds.
SUPABASE_URL=https://your_project_id.supabase.co
# Anon key / Publishable key
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- CORS ---
# Authorized frontend origins. Comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Client URL ---
# Public base URL of the customer-facing frontend, no trailing slash.
# Used by the forgot-password flow: the server passes this to Supabase's
# admin.generateLink({ type: 'recovery', redirectTo: CLIENT_URL + '/reset-password' })
# so the recovery token link in the Brevo email points back to the right origin.
#
# Must also be listed in your Supabase project's Auth → URL Configuration →
# Redirect URLs (e.g. http://localhost:5173/reset-password for local dev,
# https://your-domain.com/reset-password for production) or Supabase will
# reject the redirectTo and the reset link will not work.
#
# If unset, the redirectTo falls back to '/reset-password' (no origin), which
# is unlikely to resolve correctly — always set this explicitly.
CLIENT_URL=http://localhost:5173

# --- Brevo (transactional email) ---
# NOTE: these keys drive all transactional email; a send with no BREVO_API_KEY
# throws. On environments where email isn't wired up yet (e.g. no Brevo account
# has been provisioned), leave these unset and expect email-triggering flows to
# error - that is understood, not a regression.
# Found in Brevo Dashboard (brevo.com) -> Settings (gear) -> SMTP & API -> API Keys.
BREVO_API_KEY=your_brevo_api_key
# Required alongside BREVO_API_KEY - there is no default sender, a send with
# this unset throws. Must be a verified sender in Brevo (Settings -> Senders,
# Domains & Dedicated IPs -> Senders); verify the whole domain for production
# deliverability.
# Format: "Display Name <address@domain.com>".
BREVO_FROM_EMAIL=The Golden Fur <thegoldenfur.dev@gmail.com>

# --- Staff temp-credential encryption ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts a staff member's temporary password at rest (staff_profiles.
# temp_credential_ciphertext/-_iv) so a resend can re-deliver the same
# password instead of generating a new one.
STAFF_TEMP_CREDENTIAL_KEY=your_base64_encoded_32_byte_key

# --- MFA email-method secret encryption ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts the shared TOTP secret behind a user's "email" MFA method
# (mfa_factor_methods.secret_ciphertext/-_iv) so the server can compute and
# email the current code - a separate key from STAFF_TEMP_CREDENTIAL_KEY so
# the two can be rotated independently.
MFA_EMAIL_SECRET_KEY=your_base64_encoded_32_byte_key

# --- Scheduled jobs tick ---
# Shared secret for POST /jobs/tick, which Supabase pg_cron calls every minute
# to run the reminder jobs (checkout reminder, appointment reminder, nightly
# care-log summary). Must equal the Supabase Vault secret 'jobs_tick_secret' -
# see supabase/migrations/20261022279_custom_jobs_tick_cron.sql. Unset = the
# endpoint refuses every call (503); locally the in-process pollers still run.
# Generate with: openssl rand -hex 32
JOBS_TICK_SECRET=your_jobs_tick_secret
