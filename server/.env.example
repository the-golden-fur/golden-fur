# --- Execution Environment ---
# Controls app behavior (logging, error detail)
# Options: development, test, production
NODE_ENV=development

# --- Network Configuration ---
SERVER_PORT=3000

# --- Supabase Configuration ---
# Found in Supabase Dashboard → Settings → API
# This repo's dev branch targets the "golden-fur-dev" Supabase project;
# main targets "golden-fur". Confirm which project ref your local .env
# points at before running migrations or seeds.
SUPABASE_URL=https://your_project_id.supabase.co
# Anon key / Publishable key
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- CORS ---
# Authorized frontend origins. Comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Brevo (transactional email) ---
# NOTE: these keys drive all transactional email; a send with no BREVO_API_KEY
# throws. On environments where email isn't wired up yet (e.g. no Brevo account
# has been provisioned), leave these unset and expect email-triggering flows to
# error - that is understood, not a regression.
# Found in Brevo Dashboard (brevo.com) -> Settings (gear) -> SMTP & API -> API Keys.
BREVO_API_KEY=your_brevo_api_key
# Must be a verified sender in Brevo (Settings -> Senders, Domains & Dedicated
# IPs -> Senders); verify the whole domain for production deliverability.
# Format: "Display Name <address@domain.com>".
BREVO_FROM_EMAIL=Golden Fur <noreply@goldenfur.com>

# --- Staff temp-credential encryption ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts a staff member's temporary password at rest (staff_profiles.
# temp_credential_ciphertext/-_iv) so a resend can re-deliver the same
# password instead of generating a new one.
STAFF_TEMP_CREDENTIAL_KEY=your_base64_encoded_32_byte_key
