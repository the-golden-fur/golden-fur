# Line endings: store every text file as LF, and check it out as LF on every
# platform (Windows included). This ends the `core.autocrlf=true` churn where
# `git`/`prettier` see hundreds of files as "modified" purely on CR vs LF.
* text=auto eol=lf

# Shell scripts must stay LF even if a future .gitattributes relaxes the above.
*.sh text eol=lf

# Binary assets: never normalize, never diff as text.
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
